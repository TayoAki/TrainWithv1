{
  "name": "TrainWith",
  // package.json requires Node >=22.13; the default Codespaces image may ship
  // an older LTS, so pin it here rather than relying on whatever is present.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm ci",
  "forwardPorts": [8081, 8080],
  "portsAttributes": {
    "8081": {
      "label": "Expo web (npm run web)",
      "onAutoForward": "openPreview"
    },
    "8080": {
      "label": "Static web bundle (script/serve_web.py)",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
