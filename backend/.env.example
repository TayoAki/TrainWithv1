NODE_ENV=development
PORT=3001
APP_URL=http://localhost:8081
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:4321
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
# Optional PEM CA certificate; certificate verification stays enabled.
DATABASE_CA_CERT=
# Sandbox only. Live keys are rejected by this implementation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
# Set the agreed fee before enabling Checkout. No fee is silently assumed.
PLATFORM_FEE_PERCENT=
CONNECT_COUNTRY=US
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=
# Native purchases require a reviewed catalog and store reconciliation; disabled in code.
# UUIDs of operators permitted to view support and approve channels.
ADMIN_USER_IDS=
